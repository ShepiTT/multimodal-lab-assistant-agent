# 百度语音API（ASR/TTS）
BAIDU_API_KEY=xxx
BAIDU_SECRET_KEY=xxx
BAIDU_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_ASR_URL=https://vop.baidu.com/server_api
BAIDU_TTS_URL=https://tsn.baidu.com/text2audio

# 阿里云通义千问API（文本）
ALI_API_KEY=sk-xxx
ALI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# 阿里云通义千问API（视觉推理）
ALI_VL_API_KEY=sk-xxx
ALI_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


#DeepSeek API
DEEPSEEK_API_KEY = sk-xxx
DEEPSEEK_BASE_URL = https://api.deepseek.com


# 火山引擎API
ARK_API_KEY = xxx
APK_BASE_URL = https://ark.cn-beijing.volces.com/api/v3

# Metaso 联网搜索API
METASO_API_KEY=mk-xxx

# ===== 服务与安全配置 =====
# 监听地址：默认 127.0.0.1 仅本机可访问；需要局域网访问时改为 0.0.0.0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# 调试模式：默认关闭，生产环境切勿开启
FLASK_DEBUG=false
# 管理接口 Token：设置后，修改提示词/知识库管理等接口必须携带 X-Admin-Token 请求头；
# 未设置时管理接口仅允许本机访问
ADMIN_TOKEN=
# 是否在启动时自动拉起 Docker Desktop 和 Piston 容器（代码沙箱）
AUTO_START_DOCKER=true
# HuggingFace 下载源：默认使用 hf-mirror.com 镜像，可改为 https://huggingface.co
# HF_ENDPOINT=https://hf-mirror.com

# ===== RAG 检索配置 =====
# 精排（Reranker）：默认关闭；开启后首次检索会下载并加载 Cross-Encoder 模型
RERANKER_ENABLED=false
# 精排模型，默认 BAAI/bge-reranker-base，可换 Qwen/Qwen3-Reranker-0.6B 等
# RERANKER_MODEL=BAAI/bge-reranker-base